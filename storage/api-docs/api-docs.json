        "/api/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Cadastrar usuário",
                "operationId": "b22b8f3540bd56ac6281fb4bedcd4f6f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "username",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Matheus"
                                    },
                                    "username": {
                                        "type": "string",
                                        "example": "matheus"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "matheus@email.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "senha1234"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "example": "senha1234"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuário criado"
                    },
                    "422": {
                        "description": "Dados inválidos"
                    }
                }
            }
        },
